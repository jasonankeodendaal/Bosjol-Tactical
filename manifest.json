{
  "id": "/",
  "name": "Bosjol Tactical Dashboard",
  "short_name": "Bosjol",
  "description": "Comprehensive tactical operations dashboard for airsoft players and administrators. Track player progression, ranks, leaderboards, gear rentals, upcoming operations, and tactical game rules.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "fullscreen"
  ],
  "orientation": "any",
  "theme_color": "#0a0a0a",
  "background_color": "#09090b",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "games",
    "sports",
    "entertainment",
    "utilities"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "name": "Bosjol Tactical Mission File",
      "accept": {
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+bosjol",
      "url": "/?operation=%s"
    }
  ],
